flowchart TD
    Start([Start]) --> MouseEvents[Mouse Events]
    
    MouseEvents --> MD[MouseDown]
    MouseEvents --> MM[MouseMove]
    MouseEvents --> MU[MouseUp]
    
    MD --> MD_ButtonCheck{Button Pressed?}
    
    MD_ButtonCheck --> |Left Button 0| MD_Left
    MD_ButtonCheck --> |Middle Button 1| MD_Middle
    
    MD_Middle --> MD_PanStart[Set panStartRef.current<br/>to current position]
    
    MD_Left --> MD_GetPos[getMousePosevt]
    MD_GetPos --> MD_FindSnap[findSnappos]
    MD_GetPos --> MD_ScreenToWorld[screenToWorldpos.x, pos.y]
    
    MD_FindSnap --> MD_SnapCheck{Snap found?}
    MD_SnapCheck --> |Yes| MD_UseSnap[finalPos = snap]
    MD_SnapCheck --> |No| MD_UseWorld[finalPos = screenToWorld result]
    
    MD_UseSnap --> MD_ConstraintCheck
    MD_UseWorld --> MD_ConstraintCheck
    
    MD_ConstraintCheck --> MD_ShiftCheck{Shift Held?}
    
    MD_ShiftCheck --> |Yes + previewEnd exists| MD_UsePreviewEnd[finalPos = previewEnd]
    MD_ShiftCheck --> |No + currentStart exists| MD_ApplyOrtho[applyOrthoConstraintcurrentStart, cursorWorld]
    
    MD_ApplyOrtho --> MD_ConstrainedCheck{Constrained?}
    MD_ConstrainedCheck --> |Yes| MD_UseConstrained[finalPos = constrained position]
    MD_ConstrainedCheck --> |No| MD_KeepCurrent[Keep current finalPos]
    
    MD_UsePreviewEnd --> MD_CurrentStartCheck
    MD_UseConstrained --> MD_CurrentStartCheck
    MD_KeepCurrent --> MD_CurrentStartCheck
    
    MD_CurrentStartCheck --> MD_StartCheck{currentStart exists?}
    
    MD_StartCheck --> |No| MD_SetStart[setCurrentStartfinalPos]
    MD_StartCheck --> |Yes| MD_CommitLine[Add new line to lines array<br/>Set new currentStart<br/>Clear previewEnd]
    
    MM --> MM_GetPos[getMousePosevt]
    MM_GetPos --> MM_PanCheck{panStartRef exists?}
    
    MM_PanCheck --> |Yes| MM_Pan[Update offsetX/Y<br/>Set new panStartRef<br/>redrawAllpreviewEnd, snapPoint]
    
    MM_PanCheck --> |No| MM_CurrentStartCheck{currentStart exists?}
    MM_CurrentStartCheck --> |No| MM_End[End]
    MM_CurrentStartCheck --> |Yes| MM_FindSnap[findSnappos]
    MM_FindSnap --> MM_ScreenToWorld[screenToWorldpos.x, pos.y]
    
    MM_FindSnap --> MM_SnapCheck{Snap found?}
    MM_SnapCheck --> |Yes| MM_UseSnap[cursorWorld = snap]
    MM_SnapCheck --> |No| MM_UseWorld[cursorWorld = screenToWorld result]
    
    MM_UseSnap --> MM_ShiftCheck
    MM_UseWorld --> MM_ShiftCheck
    
    MM_ShiftCheck --> MM_ShiftHeld{Shift Held?}
    
    MM_ShiftHeld --> |Yes| MM_CalculateOrtho[Calculate preview using<br/>nearestOrthoAngleDeg<br/>and trigonometric projection]
    MM_ShiftHeld --> |No| MM_ApplyConstraint[applyOrthoConstraintcurrentStart, cursorWorld]
    
    MM_ApplyConstraint --> MM_ConstrainedCheck{Constrained?}
    MM_ConstrainedCheck --> |Yes| MM_UseConstrained[preview = constrained position]
    MM_ConstrainedCheck --> |No| MM_UseCursor[preview = cursorWorld]
    
    MM_CalculateOrtho --> MM_SetPreview[setPreviewEndpreview]
    MM_UseConstrained --> MM_SetPreview
    MM_UseCursor --> MM_SetPreview
    
    MM_SetPreview --> MM_RendererSetup[Setup renderer ortho config<br/>colors, dash, thickness, etc.]
    MM_RendererSetup --> MM_Redraw[redrawAllpreview, snap]
    
    MU --> MU_ButtonCheck{Button Released?}
    MU_ButtonCheck --> |Middle Button 1| MU_ClearPan[Set panStartRef.current = null]
    MU_ButtonCheck --> |Other Buttons| MU_End[End]
    
    style Start fill:#e1f5fe
    style MD fill:#fff3e0
    style MM fill:#e8f5e8
    style MU fill:#fbe9e7